# VoxAct Environment Configuration
# Copy this file to .env and fill in your API keys

# Rime TTS Configuration
RIME_API_KEY=your_rime_api_key_here
# Active language profile defaults to English (dynamic multilingual auto-switching supported)
# Language Profiles:
#   English (en): modelId=mist, speaker=cove, lang=eng
#   Tamil (ta):   modelId=arcana, speaker=anaya, lang=tam
#   Hindi (hi):   modelId=coda, speaker=taru, lang=hin
RIME_MODEL_ID=mist
RIME_SPEAKER=cove
RIME_LANGUAGE=eng
RIME_AUDIO_FORMAT=mp3
RIME_ENDPOINT=wss://users-ws.rime.ai/ws3

# LLM Configuration (Groq LPU or OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Nearby Healthcare Care Navigation & Mapping (Optional)
# OpenStreetMap Nominatim is used by default with verified local clinic fallbacks.
# If integrating Google Places / Geocoding API:
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server Configuration
PORT=3000
